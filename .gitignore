secrets.yaml
.storage/*
# ChoreOps holds the ENTIRE kids' reward chart - 20 chores, rewards, penalties,
# bonuses, points - and nothing else in the repo can rebuild it. No secrets in
# it (ha_user_id is empty), so it is the one .storage path worth versioning.
# Everything else there (auth, config_entries, tokens) stays ignored.
!.storage/choreops/
.storage/choreops/*.bak*
.storage/choreops/*reset*
.storage/choreops/*recovery*
.cloud/
.google.token
home-assistant_v2.db
home-assistant_v2.db-shm
home-assistant_v2.db-wal
*.db
*.db-shm
*.db-wal
*.log
*.log.*
*.pyc
__pycache__/
.*.swp
*.tmp
*.backup
backups/
tts/
deps/
ip_bans.yaml
node-red/
.cache/
*.db-journal

# --- added 2026-08-10 ---
# HA runtime lock, rewritten on every start
.ha_run.lock
# rollback copies taken while editing
*.bak
*.bak.*
*.pre-dupfix
*.pre-energy
*.sections-backup
# duplicate of www/property-aerial.png, which is what the dashboard references
www/lugh/

# doorbell snapshots, regenerated at runtime
www/ring/
